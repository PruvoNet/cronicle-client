  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
